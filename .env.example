# ───────────────────────────────────────────────────────────────
# Copy to `.env` locally. NEVER commit real values.
# Each app validates ONLY its own variables with Zod at startup
# (see apps/*/src/**/env.ts). Missing/invalid values stop the process.
# ───────────────────────────────────────────────────────────────

# ── Shared ──────────────────────────────────────────────────────
NODE_ENV=development

# ── apps/web (public: bundled into the browser, NO secrets here) ─
VITE_APP_ENV=development
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable/anon key (safe for the browser, protected by RLS)
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# ── apps/api (server only) ──────────────────────────────────────
API_PORT=8787
API_LOG_LEVEL=info
# Comma-separated list of allowed browser origins (CORS)
API_ALLOWED_ORIGINS=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# SECRET — server only (api/worker). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Direct Postgres connection (server only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── apps/worker (server only) ───────────────────────────────────
WORKER_LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=5000
