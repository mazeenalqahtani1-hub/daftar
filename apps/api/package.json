{
  "name": "@daftar/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Thin HTTP API (Hono + Zod). Validates input, authorizes, and calls PostgreSQL api.* functions. No financial logic here.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@daftar/db": "workspace:*",
    "@daftar/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "pino": "^10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@daftar/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
