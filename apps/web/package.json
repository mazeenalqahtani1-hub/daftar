{
  "name": "@daftar/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Customer & merchant PWA (React + Vite). UI only: no financial logic, no direct writes to financial tables.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
